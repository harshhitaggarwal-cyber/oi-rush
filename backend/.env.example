# Copy to backend/.env for local development; never commit real credentials.
OI_RUSH_PROVIDER_BASE_URL=
OI_RUSH_PROVIDER_TOKEN=
OI_RUSH_PROVIDER_NAME=

# Official NSE F&O trading holidays for 2026 (snapshot session date).
OI_RUSH_NSE_CALENDAR_YEAR=2026
OI_RUSH_NSE_HOLIDAYS=2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25
# Add only after the exchange confirms a special session includes the intended snapshot time.
OI_RUSH_NSE_SPECIAL_SESSIONS=

# MCX dates when the 18:00 IST snapshot-time session is closed in 2026.
# MCX can reopen in the evening on some dates when the morning session is closed.
OI_RUSH_MCX_CALENDAR_YEAR=2026
OI_RUSH_MCX_HOLIDAYS=2026-01-01,2026-01-26,2026-04-03,2026-10-02,2026-12-25
# Add special sessions only after checking the official session timings at 18:00 IST.
OI_RUSH_MCX_SPECIAL_SESSIONS=

OI_RUSH_DB_PATH=data/oi_rush.sqlite3
