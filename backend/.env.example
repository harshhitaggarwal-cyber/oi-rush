# Copy to .env locally; never commit real credentials.
OI_RUSH_PROVIDER_BASE_URL=
OI_RUSH_PROVIDER_TOKEN=
OI_RUSH_PROVIDER_NAME=
# Populate from complete official calendars; empty values disable snapshotting.
OI_RUSH_NSE_HOLIDAYS=
OI_RUSH_NSE_SPECIAL_SESSIONS=
OI_RUSH_MCX_HOLIDAYS=
OI_RUSH_MCX_SPECIAL_SESSIONS=
OI_RUSH_DB_PATH=data/oi_rush.sqlite3
